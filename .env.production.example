# RWM — Production Environment Variables
# Copy this file and fill in all required values before deploying.
# NEVER commit real secrets to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public URL of your deployment (used for Socket.io CORS)
# e.g. https://retro.company.com  or  http://your-server:8101
ALLOWED_ORIGIN=http://your-server:8101

# ── Optional: Admin Bootstrap ──────────────────────────────────────────────────
# This account is created automatically on first start if it does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional: LDAP ────────────────────────────────────────────────────────────
# Leave blank to disable the LDAP login tab.
LDAP_URL=ldap://your-dc.company.com:389
LDAP_BASE_DN=DC=company,DC=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={{username}})

# ── Optional: Microsoft EntraID / Azure AD ────────────────────────────────────
# Leave blank to disable the Microsoft login tab.
ENTRAID_TENANT_ID=
ENTRAID_CLIENT_ID=
ENTRAID_CLIENT_SECRET=
ENTRAID_REDIRECT_URI=https://your-server/api/auth/entraid/callback
